# Copy to .env.local for local development, and set the same variables in the
# hosting provider (Vercel → Project → Settings → Environment Variables).

# ── Neon (Postgres) ────────────────────────────────────────────────────────────
# Written by `neon env pull` / `neon deploy`. DATABASE_URL is the pooled
# connection the site uses; DATABASE_URL_UNPOOLED (direct) is used for migrations.
# Without them the site still works; enquiries just are not logged.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── WhatsApp orders ────────────────────────────────────────────────────────────
# The number "Send message" opens WhatsApp to, international format, digits only.
# Defaults to the test admin number 8801772121294 (src/config/site.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Site address ───────────────────────────────────────────────────────────────
# Canonical URL, sitemap and share images. Defaults to https://sartorial-bd.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Cloudflare R2 (media) ──────────────────────────────────────────────────────
# The bucket's public address. Leave empty to serve media from this site
# (public/media/); set it only after `npm run media:upload` has filled the bucket.
NEXT_PUBLIC_MEDIA_URL=
# S3 API credentials for `npm run media:upload` (an R2 API token with Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Newsletter (optional) ──────────────────────────────────────────────────────
# Sign-ups are stored in Neon when DATABASE_URL is set. Optionally also POSTed as
# JSON ({ email, source, subscribedAt }) to a Mailchimp/Klaviyo/Brevo/Zapier hook:
NEWSLETTER_WEBHOOK_URL=
