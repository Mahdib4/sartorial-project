# Copy to .env.local for local development, and set the same variables in the
# hosting provider (Vercel → Project → Settings → Environment Variables).

# ── Neon (Postgres) ────────────────────────────────────────────────────────────
# Written by `neon env pull` / `neon deploy`. DATABASE_URL is the pooled
# connection the site uses; DATABASE_URL_UNPOOLED (direct) is used for migrations.
# Without them the site still works on the built-in catalogue; the admin is
# unavailable and enquiries are not logged.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Builds on Vercel apply migrations for Production only; set this to 1 on Preview
# when previews use their own Neon branch.
MIGRATE_ON_PREVIEW=

# ── Admin panel (/admin) ───────────────────────────────────────────────────────
# The password for /admin. Once signed in it can be changed under Settings, after
# which this value is ignored.
ADMIN_PASSWORD=
# Optional: a long random string that signs admin sessions (defaults to DATABASE_URL).
ADMIN_SESSION_SECRET=

# ── WhatsApp orders ────────────────────────────────────────────────────────────
# The number "Send message" opens WhatsApp to, international format, digits only.
# Defaults to the test admin number 8801772121294 (src/config/site.ts). Once the
# database is connected, the number set in the admin (Settings) is used instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Site address ───────────────────────────────────────────────────────────────
# Canonical URL, sitemap and share images. Defaults to https://sartorial-bd.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Cloudflare R2 (media) ──────────────────────────────────────────────────────
# The bucket's public address. Leave empty to serve media from this site
# (public/media/); set it only after `npm run media:upload` has filled the bucket.
NEXT_PUBLIC_MEDIA_URL=
# S3 API credentials (an R2 API token with Object Read & Write): used by photo
# uploads in the admin and by `npm run media:upload`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: defaults to sartorial-media.
R2_BUCKET=
# Optional: the full S3 endpoint, instead of R2_ACCOUNT_ID
R2_ENDPOINT=
# Optional: where photos uploaded in the admin are served from (the bucket's public
# address or its custom domain). Defaults to the bucket's r2.dev address.
R2_PUBLIC_URL=

# ── Newsletter (optional) ──────────────────────────────────────────────────────
# Sign-ups are stored in Neon when DATABASE_URL is set. Optionally also POSTed as
# JSON ({ email, source, subscribedAt }) to a Mailchimp/Klaviyo/Brevo/Zapier hook:
NEWSLETTER_WEBHOOK_URL=
